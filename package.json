{
  "name": "daily-plenty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts tests/frontend/*.test.ts",
    "check:routes": "node scripts/check-routes.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "backup": "node --env-file-if-exists=.env.local --import tsx scripts/backup.ts",
    "configure": "node scripts/configure.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:scripts": "node --test scripts/*.test.mjs deploy/scripts/*.test.mjs deploy/config/*.test.mjs",
    "test:skill": "python3 -B -m unittest discover -s tests/skills -p 'test_*.py'",
    "check:architecture": "node scripts/check-architecture.mjs"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "0.45.2",
    "next": "15.5.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "20.19.17",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "prettier": "3.7.4",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  }
}
